{
  "name": "@greenharness/greentopo",
  "version": "__VERSION__",
  "description": "Ask what the current architecture decision is, and get a typed answer",
  "keywords": [
    "adr",
    "architecture",
    "architecture-decision-record",
    "decision-record",
    "governance",
    "documentation"
  ],
  "homepage": "https://github.com/greenharness/greentopo#readme",
  "bugs": "https://github.com/greenharness/greentopo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenharness/greentopo.git"
  },
  "license": "MIT",
  "author": "Frederic Rousseau",
  "type": "commonjs",
  "_comment_name": "The package is `@greenharness/greentopo` and the binary it installs is `greentopo`. It lives under the @greenharness scope with greengate's packages (ADR-0074); crates.io and Homebrew carry the plain name.",
  "_comment_access": "Scoped packages default to RESTRICTED. The workflow passes --access public; this says the same in the manifest so a hand-run `npm publish` cannot publish the root as private.",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "greentopo": "bin/greentopo.js"
  },
  "files": [
    "bin/greentopo.js",
    "bin/native.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@greenharness/greentopo-darwin-arm64": "__VERSION__",
    "@greenharness/greentopo-darwin-x64": "__VERSION__",
    "@greenharness/greentopo-linux-arm64-gnu": "__VERSION__",
    "@greenharness/greentopo-linux-x64-gnu": "__VERSION__",
    "@greenharness/greentopo-linux-x64-musl": "__VERSION__",
    "@greenharness/greentopo-win32-x64": "__VERSION__"
  }
}
